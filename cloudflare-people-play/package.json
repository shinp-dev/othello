{
  "name": "chanriva-people-play",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test-worker.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test --test-concurrency=1 test/*.test.mjs",
    "dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  }
}
