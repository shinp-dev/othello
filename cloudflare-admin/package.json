{
  "name": "othello-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.batch.json --noEmit",
    "build:test": "tsc --outDir dist && tsc -p tsconfig.batch.json",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "research:batch": "node dist-batch/research-batch.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
